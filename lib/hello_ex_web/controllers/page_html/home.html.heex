<.flash_group flash={@flash} />
<h1 class="text-2xl font-bold p-3">Top Five</h1>
<nav class="p-2">
  <ul class="flex flex-col gap-3 items-center">
    <li class="w-full">
      {live_render(@conn, HelloExWeb.NewGameLive)}
    </li>
    <li>
      <form>
        <div class="flex flex-col gap-1">
          <label for="join-code" class="text-sm text-gray-400">Enter game code</label>
          <div class="flex gap-2">
            <input id="join-code" type="text" class="bg-gray-900 rounded border-gray-700" />
            <button class="bg-sky-600 text-sky-100 font-semibold p-2 px-4 rounded">Join</button>
          </div>
        </div>
      </form>
    </li>
    <li>
      <button class="rounded p-1 px-2 bg-gray-900 text-gray-200">What is this?</button>
    </li>
  </ul>
</nav>
