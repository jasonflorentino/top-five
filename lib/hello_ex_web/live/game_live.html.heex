<h1>The real game</h1>

<section id="players">
  <div>
    <h2>Players</h2>
    <ul>
      <li>Player 1</li>
    </ul>
  </div>
</section>

<section id="game_code">
  <h3>Game Code</h3>
  <span>{@game_id}</span>
  <button>Copy Link</button>
</section>

<section id="bowl">
  <h2>Items</h2>
</section>

<nav id="actions">
  <form>
    <label for="player_name">Enter your name</label>
    <input id="player_name" type="text" />
    <button>Submit</button>
  </form>

  <button>Start Game</button>
</nav>
