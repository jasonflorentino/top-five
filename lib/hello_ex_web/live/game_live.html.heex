<section id="player">
  <%= case @user do %>
    <% %{name: name} -> %>
    <p>User: <%= name %></p>
    <% _ -> %>
    <p>User: Unknown</p>
  <% end %>
</section>
<section id="players" class="border">
  <div>
    <h2>Players</h2>
    <ul>
    <%= if not Enum.empty?(@users) do %>
      <%= for user <- @users do %>
          <li>
            <p>Name: <%= user.name %></p>
            <p>ID: <%= user.id%></p>
          </li>
      <% end %>
    <% else %>
      <li>No players</li>
    <% end %>
    </ul>
  </div>
</section>

<section id="game_code">
  <h3>Game Code</h3>
  <span>{@game_id}</span>
  <button>Copy Link</button>
</section>

<section id="bowl">
  <h2>Items</h2>
</section>

<nav id="actions">
  <form>
    <label for="player_name">Enter your name</label>
    <input id="player_name" type="text" />
    <button>Submit</button>
  </form>

  <button>Start Game</button>
</nav>
